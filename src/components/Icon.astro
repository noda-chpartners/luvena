---
interface Props {
  name: "line" | "instagram" | "phone" | "pin" | "clock" | "arrow" | "calendar";
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === "line" && (
      <path
        fill="currentColor"
        d="M19.4 10.6c0-3.7-3.7-6.7-8.2-6.7S3 6.9 3 10.6c0 3.3 2.9 6.1 6.9 6.6.3.1.6.2.7.4.1.2 0 .5 0 .7l-.1.8c0 .3-.1 1 .9.6.9-.5 4.8-2.8 6.6-4.8 1.2-1.3 1.4-2.6 1.4-3.3zm-11 1.8H7.2a.5.5 0 0 1-.5-.5V9.1c0-.3.2-.5.5-.5s.5.2.5.5v2.3h.7c.3 0 .5.2.5.5s-.2.5-.5.5zm1.7 0a.5.5 0 0 1-.5-.5V9.1c0-.3.2-.5.5-.5s.5.2.5.5v2.8c0 .3-.2.5-.5.5zm4.3 0a.5.5 0 0 1-.4-.2l-1.8-2.4v2.1c0 .3-.2.5-.5.5s-.5-.2-.5-.5V9.1c0-.2.1-.4.3-.5.2-.1.4 0 .5.1l1.8 2.4V9.1c0-.3.2-.5.5-.5s.5.2.5.5v2.8c0 .3-.2.5-.4.5zm2.6-2.3a.5.5 0 0 1 0 1h-1.3v.8h1.3c.3 0 .5.2.5.5s-.2.5-.5.5h-1.8a.5.5 0 0 1-.5-.5V9.1c0-.3.2-.5.5-.5h1.8c.3 0 .5.2.5.5s-.2.5-.5.5h-1.3v.8h1.3z"
      />
    )
  }
  {
    name === "instagram" && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="3.6" />
        <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    name === "phone" && (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        d="M8.2 4.6h2l1.2 3-1.5 1a12 12 0 0 0 5.5 5.5l1-1.5 3 1.2v2c0 .8-.6 1.6-1.4 1.7C9.6 18.4 5.6 14.4 4.7 6c0-.8.8-1.4 1.6-1.4h1.9z"
      />
    )
  }
  {
    name === "pin" && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z" />
        <circle cx="12" cy="11" r="2" />
      </g>
    )
  }
  {
    name === "clock" && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="8" />
        <path d="M12 8v4.5l3 2" />
      </g>
    )
  }
  {
    name === "calendar" && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <rect x="4" y="5" width="16" height="15" rx="2" />
        <path d="M8 3.5v3M16 3.5v3M4 10h16" />
      </g>
    )
  }
  {
    name === "arrow" && (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M5 12h14M13 6l6 6-6 6"
      />
    )
  }
</svg>
