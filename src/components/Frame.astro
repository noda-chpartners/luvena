---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  sizes: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  position?: string;
}

const {
  src,
  alt,
  caption,
  class: className,
  sizes,
  widths = [480, 768, 1108],
  loading = "lazy",
  position = "center",
} = Astro.props;
---

<figure class:list={["frame", className]} data-photo>
  <div class="frame__media" style={`--pos: ${position}`}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      quality={76}
      class="frame__img"
    />
  </div>
  {caption && <figcaption class="frame__cap">{caption}</figcaption>}
</figure>
